# ${{ values.name }} - generated by the FastFlow NestJS golden path
FROM node:22-alpine AS build
WORKDIR /app
COPY package*.json ./
# Generated projects start without a lockfile; commit one and switch to npm ci.
RUN npm install
COPY . .
RUN npm run build

FROM node:22-alpine
ENV NODE_ENV=production
WORKDIR /app
COPY package*.json ./
RUN npm install --omit=dev && npm cache clean --force
COPY --from=build /app/dist ./dist
USER node
EXPOSE 3000
CMD ["node", "dist/main.js"]
