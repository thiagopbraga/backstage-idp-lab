# Copy to .env and adjust:  cp .env.example .env
# Never commit .env (it is git-ignored). In Kubernetes/OpenShift these values come
# from Secrets/ConfigMaps or an external secret manager (AWS Secrets Manager / Vault).

# --- PostgreSQL ---
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=backstage
POSTGRES_PASSWORD=change-me-local-only

# --- Backstage URLs ---
# Local dev (yarn start): frontend on :3000, backend on :7007
APP_BASE_URL=http://localhost:3000
BACKEND_BASE_URL=http://localhost:7007

# --- Demo identity (guest provider, local only) ---
# Any User from examples/org.yaml. The permission policy (stage 4) treats them as:
#   user:default/ana.souza    -> claims-squad: owns claims-* entities
#   user:default/bruno.lima   -> policy-squad: owns policy-* entities
#   user:default/thiago.braga -> fastflow: platform admin (break-glass, allowed everything)
# Restart the backend after changing it (docker compose up -d / yarn start).
BACKSTAGE_GUEST_USER=user:default/ana.souza

# --- Integrations (optional; leave empty to run offline) ---
# Fine-grained PAT with read-only access to the repos referenced by the catalog.
# Leave it COMMENTED OUT (not empty) when unused: Backstage rejects empty strings
# in config, while an unset variable simply drops the key.
# GITHUB_TOKEN=github_pat_xxx

# --- code-quality plugin (stage 2) ---
# auto = live for providers with a token, mock otherwise | mock | live
CODE_QUALITY_MODE=auto
# SonarQube Server or SonarCloud. Token needs only "Browse" on the projects.
# SONARQUBE_BASE_URL=https://sonarcloud.io
# SONARQUBE_TOKEN=squ_xxx

# --- FastFlow golden paths (stage 3) ---
# Output folder of fastflow:publish:local (offline publish target)
FASTFLOW_LOCAL_OUTPUT_DIR=/tmp/fastflow-golden-paths
